# Configuração de desenvolvimento (local, sem secrets).
#
# O `react-native-dotenv` já resolve sozinho, por esta ordem de precedência:
#   .env  <  .env.local  <  .env.<APP_ENV>  <  .env.<APP_ENV>.local
# O valor de <APP_ENV> vem de APP_ENV/EXPO_PUBLIC, ou de NODE_ENV.
# Nenhum destes ficheiros é commitado excepto .env.example.
API_URL=http://192.168.18.5:3000

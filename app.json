{
	"expo": {
		"name": "Boleia",
		"slug": "boleia",
		"owner": "ft_lantonio",
		"version": "0.1.0",
		"scheme": "boleia",
		"orientation": "portrait",
		"icon": "./assets/images/logo.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "ao.boleia.app"
		},
		"android": {
			"package": "ao.boleia.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/logo.png",
				"backgroundColor": "#F7F3E7"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/images/logo.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-secure-store",
			"expo-font",
			"@react-native-community/datetimepicker",
			"expo-web-browser",
			[
				"expo-image-picker",
				{
					"photosPermission": "A Boleia precisa de aceder às tuas fotografias para carregares o teu BI, os teus selfies e as fotos da tua viatura.",
					"cameraPermission": "A Boleia usa a câmara para fotografar o teu BI e a tua carta de condução."
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "A Boleia usa a tua localização durante a viagem para o motorista e os passageiros saberem por onde vão."
				}
			],
			[
				"expo-notifications",
				{
					"color": "#0071EB",
					"defaultChannel": "boleia"
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/logo.png",
					"resizeMode": "contain",
					"backgroundColor": "#F7F3E7"
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": "dd4d32db-d0a0-42fc-9d4e-1e61d8a4d079"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/dd4d32db-d0a0-42fc-9d4e-1e61d8a4d079"
		}
	}
}

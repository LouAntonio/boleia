{
	"expo": {
		"name": "Boleia",
		"slug": "boleia",
		"owner": "ft_lantonio",
		"version": "0.1.0",
		"scheme": "boleia",
		"orientation": "portrait",
		"icon": "./assets/images/logo.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/logo.png",
				"backgroundColor": "#F7F3E7"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/images/logo.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-secure-store",
			"expo-font",
			"@react-native-community/datetimepicker",
			"expo-web-browser",
			"expo-notifications",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/logo.png",
					"resizeMode": "contain",
					"backgroundColor": "#F7F3E7"
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": "dd4d32db-d0a0-42fc-9d4e-1e61d8a4d079"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/dd4d32db-d0a0-42fc-9d4e-1e61d8a4d079"
		}
	}
}

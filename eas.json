{
	"cli": {
		"version": ">= 12.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"APP_ENV": "preview"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"APP_ENV": "production"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
